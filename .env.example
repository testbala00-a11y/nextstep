# Supabase Project Settings → API → Project URL and publishable/anon key
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Server runtime values for TanStack Start SSR/RPC
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Only if trusted server-side functions require it; NEVER prefix with VITE_
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET
# Optional, only for drizzle-kit direct database migrations (server/terminal only)
# DATABASE_URL=postgresql://...
